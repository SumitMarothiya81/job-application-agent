# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit the real file.
GOOGLE_API_KEY = "your_key_here"
GEMINI_MODELS = "gemini-3.5-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite"
DEMO_SESSION_LIMIT = "5"
DEMO_DAILY_LIMIT = "100"

# Job discovery (free keys from https://developer.adzuna.com). Optional: without them the
# Discover tab still works with CSV import or visitors' own keys.
ADZUNA_APP_ID = "your_adzuna_app_id"
ADZUNA_APP_KEY = "your_adzuna_app_key"
ADZUNA_COUNTRY = "in"
DISCOVERY_SESSION_LIMIT = "5"
DISCOVERY_DAILY_LIMIT = "30"

# Apply assistant (each run makes about 4-6 Gemini calls)
AGENT_SESSION_LIMIT = "2"
AGENT_DAILY_LIMIT = "15"
